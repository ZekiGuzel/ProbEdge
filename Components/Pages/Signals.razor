@page "/signals"
@using ProbEdge.Services
@inject PolymarketService PolymarketService

<div class="dashboard">
    <div class="dash-header">
        <div>
            <h1 class="dash-title">⚡ Live Signals</h1>
            <p class="dash-subtitle">Real-time BUY & DROP signals powered by Polymarket data</p>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Analyzing markets...</p>
        </div>
    }
    else
    {
        <div class="signals-row" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); display:grid; gap:1rem;">
            @foreach (var signal in _signals)
            {
                <div class="signal-card @(signal.Type == "BUY" ? "signal-buy" : "signal-drop")">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                        <div class="signal-type">@signal.Type</div>
                        <div style="font-size:0.7rem; color:#64748b;">Signal Strength: @signal.Strength%</div>
                    </div>
                    <div class="signal-market">@signal.MarketTitle</div>
                    <div class="signal-detail">
                        <span>Prob: @signal.Probability%</span>
                        <span class="@(signal.Change >= 0 ? "positive" : "negative")">
                            @(signal.Change >= 0 ? "+" : "")@signal.Change%
                        </span>
                    </div>
                    <div style="margin-top:0.8rem; font-size:0.75rem; color:#64748b;">
                        Vol 24h: @signal.Volume24h · Liquidity: @signal.Liquidity
                    </div>
                    <div style="margin-top:0.5rem; height:4px; background:#1e293b; border-radius:2px;">
                        <div style="height:100%; width:@signal.Strength%; background:@(signal.Type == "BUY" ? "#00ff88" : "#ff3366"); border-radius:2px; transition:width 0.5s;"></div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<SignalViewModel> _signals = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var markets = await PolymarketService.GetHotMarketsAsync();
        _signals = markets
            .Where(m => m.SignalStrength >= 30)
            .OrderByDescending(m => m.SignalStrength)
            .Select(m => new SignalViewModel
            {
                Type = m.Change > 0 ? "BUY" : "DROP",
                MarketTitle = m.Title.Length > 60 ? m.Title[..60] + "..." : m.Title,
                Probability = m.Probability,
                Change = m.Change,
                Strength = m.SignalStrength,
                Volume24h = m.Volume24h,
                Liquidity = m.Liquidity
            }).ToList();
        _loading = false;
    }

    record SignalViewModel
    {
        public string Type { get; set; } = "";
        public string MarketTitle { get; set; } = "";
        public int Probability { get; set; }
        public int Change { get; set; }
        public int Strength { get; set; }
        public string Volume24h { get; set; } = "";
        public string Liquidity { get; set; } = "";
    }
}