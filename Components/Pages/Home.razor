@page "/"
@using ProbEdge.Services
@inject PolymarketService PolymarketService
@implements IDisposable

<div class="dashboard">

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="top-bar-left">
            <span class="live-badge">● LIVE</span>
            <span class="top-bar-text">Polymarket Intelligence Platform</span>
        </div>
        <div class="top-bar-right">
            <span class="top-bar-text">Last update: @_lastUpdate</span>
            <button class="btn-refresh" @onclick="LoadMarkets" disabled="@_loading">
                @(_loading ? "⟳ Loading..." : "⟳ Refresh")
            </button>
        </div>
    </div>

    <!-- HERO STATS -->
    <div class="hero-stats">
        <div class="hero-stat">
            <div class="hero-stat-value">@_markets.Count</div>
            <div class="hero-stat-label">Active Markets</div>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
            <div class="hero-stat-value positive">@_markets.Count(m => m.Change > 0)</div>
            <div class="hero-stat-label">📈 Trending Up</div>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
            <div class="hero-stat-value negative">@_markets.Count(m => m.Change < 0)</div>
            <div class="hero-stat-label">📉 Trending Down</div>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
            <div class="hero-stat-value" style="color:#f59e0b;">@_signals.Count</div>
            <div class="hero-stat-label">⚡ Live Signals</div>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
            <div class="hero-stat-value" style="color:#3b82f6;">@_markets.Count(m => m.CommentCount > 50)</div>
            <div class="hero-stat-label">💬 Hot Discussions</div>
        </div>
    </div>

    <!-- SIGNALS STRIP -->
    @if (_signals.Any())
    {
        <div class="signals-strip">
            <div class="signals-strip-title">⚡ TOP SIGNALS</div>
            <div class="signals-strip-cards">
                @foreach (var signal in _signals.Take(6))
                {
                    <div class="strip-signal @(signal.Type == "BUY" ? "signal-buy" : "signal-drop")">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span class="signal-type">@signal.Type</span>
                            <span style="font-size:0.7rem; color:#64748b;">@signal.Strength%</span>
                        </div>
                        <div class="signal-market">@signal.MarketTitle</div>
                        <div class="signal-detail">
                            <span class="prob-value @GetProbClass(signal.Probability)">@signal.Probability%</span>
                            <span class="@(signal.Change >= 0 ? "positive" : "negative")">
                                @(signal.Change >= 0 ? "▲+" : "▼")@Math.Abs(signal.Change)%
                            </span>
                        </div>
                        <div style="margin-top:0.5rem; height:3px; background:#1e293b; border-radius:2px;">
                            <div style="height:100%; width:@signal.Strength%; background:@(signal.Type == "BUY" ? "#00ff88" : "#ff3366"); border-radius:2px;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- FILTER BAR -->
    <div class="filter-bar">
        <div class="filter-left">
            <input class="search-input" placeholder="🔍 Search markets..." @bind="_searchQuery" @bind:event="oninput" />
            <div class="category-filters">
                @foreach (var cat in _categories)
                {
                    <button class="cat-btn @(_activeCategory == cat ? "cat-active" : "")"
                            @onclick="() => SetCategory(cat)">@cat</button>
                }
            </div>
        </div>
        <div class="filter-right">
            <select class="sort-select" @bind="_sortBy">
                <option value="volume">Sort: Volume</option>
                <option value="change">Sort: Change</option>
                <option value="signal">Sort: Signal</option>
                <option value="comments">Sort: Comments</option>
            </select>
        </div>
    </div>

    <!-- MARKETS GRID -->
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading live market data...</p>
        </div>
    }
    else
    {
        <div class="markets-grid-v2">
            @foreach (var market in _sortedMarkets)
            {
                <div class="market-card-v2">

                    <!-- CARD IMAGE -->
                    @if (!string.IsNullOrEmpty(market.Image))
                    {
                        <div class="card-image">
                            <img src="@market.Image" alt="@market.Title" loading="lazy" />
                            <div class="card-image-overlay"></div>
                            <div class="card-image-badges">
                                <span class="cat-badge-img">@market.Category</span>
                                @if (market.SignalStrength >= 60)
                                {
                                    <span class="hot-badge">🔥 HOT</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card-image card-image-placeholder">
                            <div class="card-image-badges">
                                <span class="cat-badge-img">@market.Category</span>
                            </div>
                        </div>
                    }

                    <div class="card-body">

                        <!-- TITLE -->
                        <div class="market-title-v2">@market.Title</div>

                        <!-- PROBABILITY -->
                        <div class="prob-section">
                            <div class="prob-header">
                                <span class="prob-label">YES Probability</span>
                                <span class="prob-value @GetProbClass(market.Probability)">@market.Probability%</span>
                            </div>
                            <div class="probability-bar">
                                <div class="probability-fill @GetProbClass(market.Probability)"
                                     style="width:@(Math.Min(market.Probability, 100))%"></div>
                            </div>
                        </div>

                        <!-- BID / ASK -->
                        @if (market.BestBid > 0 || market.BestAsk > 0)
                        {
                            <div class="bid-ask-row">
                                <div class="bid-box">
                                    <span class="ba-label">BID</span>
                                    <span class="ba-value bid-val">@((int)(market.BestBid * 100))¢</span>
                                </div>
                                <div class="spread-box">
                                    <span class="ba-label">SPREAD</span>
                                    <span class="ba-value">@((int)((market.BestAsk - market.BestBid) * 100))¢</span>
                                </div>
                                <div class="ask-box">
                                    <span class="ba-label">ASK</span>
                                    <span class="ba-value ask-val">@((int)(market.BestAsk * 100))¢</span>
                                </div>
                            </div>
                        }

                        <!-- VOLUME TREND -->
                        <div class="volume-trend">
                            <div class="vol-item">
                                <span class="vol-label">24H</span>
                                <span class="vol-value">$@market.Volume24h</span>
                            </div>
                            <div class="vol-item">
                                <span class="vol-label">1W</span>
                                <span class="vol-value">$@market.Volume1wk</span>
                            </div>
                            <div class="vol-item">
                                <span class="vol-label">1M</span>
                                <span class="vol-value">$@market.Volume1mo</span>
                            </div>
                            <div class="vol-item">
                                <span class="vol-label">LIQ</span>
                                <span class="vol-value" style="color:#3b82f6;">$@market.Liquidity</span>
                            </div>
                        </div>

                        <!-- SIGNAL STRENGTH -->
                        <div class="signal-strength-row">
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.3rem;">
                                <span style="font-size:0.72rem; color:#64748b;">Signal Strength</span>
                                <span style="font-size:0.72rem; color:@GetSignalColor(market.SignalStrength); font-weight:600;">
                                    @GetSignalLabel(market.SignalStrength)
                                </span>
                            </div>
                            <div style="height:4px; background:#1e293b; border-radius:2px;">
                                <div style="height:100%; width:@market.SignalStrength%; background:@GetSignalColor(market.SignalStrength); border-radius:2px; transition:width 0.5s;"></div>
                            </div>
                        </div>

                        <!-- FOOTER -->
                        <div class="card-footer-v2">
                            <div style="display:flex; gap:0.5rem; align-items:center;">
                                <span class="change-badge @(market.Change >= 0 ? "change-up" : "change-down")">
                                    @(market.Change >= 0 ? "▲" : "▼") @Math.Abs(market.Change)%
                                </span>
                                @if (market.CommentCount > 0)
                                {
                                    <span style="font-size:0.72rem; color:#64748b;">💬 @market.CommentCount</span>
                                }
                                @if (market.AcceptingOrders)
                                {
                                    <span style="font-size:0.65rem; color:#00ff88; background:rgba(0,255,136,0.1); padding:0.15rem 0.4rem; border-radius:3px;">OPEN</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(market.EndDate))
                            {
                                <span class="market-date">📅 @FormatDate(market.EndDate)</span>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<MarketData> _markets = new();
    private List<SignalItem> _signals = new();
    private string _searchQuery = "";
    private string _activeCategory = "All";
    private string _sortBy = "volume";
    private bool _loading = true;
    private string _lastUpdate = "";
    private System.Timers.Timer? _timer;

    private readonly List<string> _categories = new() { "All", "Crypto", "Politics", "Economics", "Tech", "Sports", "Geopolitics", "General" };

    private List<MarketData> _filteredMarkets
    {
        get
        {
            var result = _markets.AsEnumerable();
            if (_activeCategory != "All")
                result = result.Where(m => m.Category == _activeCategory);
            if (!string.IsNullOrWhiteSpace(_searchQuery))
                result = result.Where(m => m.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            return result.ToList();
        }
    }

    private List<MarketData> _sortedMarkets => _sortBy switch
    {
        "change" => _filteredMarkets.OrderByDescending(m => Math.Abs(m.Change)).ToList(),
        "signal" => _filteredMarkets.OrderByDescending(m => m.SignalStrength).ToList(),
        "comments" => _filteredMarkets.OrderByDescending(m => m.CommentCount).ToList(),
        _ => _filteredMarkets.OrderByDescending(m => m.Volume24hRaw).ToList()
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadMarkets();
        _timer = new System.Timers.Timer(30000);
        _timer.Elapsed += async (s, e) =>
        {
            await LoadMarkets();
            await InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    private async Task LoadMarkets()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _markets = await PolymarketService.GetHotMarketsAsync();
            _signals = _markets
                .Where(m => m.SignalStrength >= 40)
                .OrderByDescending(m => m.SignalStrength)
                .Take(10)
                .Select(m => new SignalItem
                {
                    Type = m.Change > 0 ? "BUY" : "DROP",
                    MarketTitle = m.Title.Length > 45 ? m.Title[..45] + "..." : m.Title,
                    Probability = m.Probability,
                    Change = m.Change,
                    Strength = m.SignalStrength
                }).ToList();
            _lastUpdate = DateTime.Now.ToString("HH:mm:ss");
        }
        catch { }
        _loading = false;
    }

    private void SetCategory(string cat) => _activeCategory = cat;
    private string GetProbClass(int prob) => prob >= 65 ? "positive" : prob >= 40 ? "neutral" : "negative";
    private string GetSignalColor(int s) => s >= 70 ? "#00ff88" : s >= 45 ? "#f59e0b" : "#64748b";
    private string GetSignalLabel(int s) => s >= 70 ? "STRONG" : s >= 45 ? "MODERATE" : "WEAK";

    private string FormatDate(string dateStr)
    {
        if (DateTime.TryParse(dateStr, out var date))
            return date.ToString("MMM dd, yyyy");
        return dateStr;
    }

    public void Dispose() => _timer?.Dispose();

    record SignalItem
    {
        public string Type { get; set; } = "";
        public string MarketTitle { get; set; } = "";
        public int Probability { get; set; }
        public int Change { get; set; }
        public int Strength { get; set; }
    }
}